# Copy to web/.env.production for docker compose / VPS.
# NEXT_PUBLIC_* is baked at build time in Docker unless you use runtime pattern — for compose we pass build args + runtime env for server.

NODE_ENV=production
PORT=3000

# Browser → Nest (absolute URL, no trailing slash). Example: http://YOUR_HOST:3000 or https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Route Handlers (server) → Nest. In Docker Compose use the API service name:
# SERVER_API_URL=http://api:3000

NEXT_PUBLIC_DEMO_DATA=false
NEXT_PUBLIC_DISABLE_SOCKET=false
NEXT_PUBLIC_DISABLE_GEOLOCATION=false

# Refresh cookie (see .env.local.example)
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=
