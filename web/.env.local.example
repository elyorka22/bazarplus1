# Browser + Route Handlers proxy to Nest (absolute URL, no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Local demo: Oʻzbek katalogi (kategoriyalar + mahsulotlar) API o‘rniga.
NEXT_PUBLIC_DEMO_DATA=true

# Refresh cookie SameSite: lax | strict | none (none requires HTTPS + Secure).
# Production (app on Vercel + API on api.domain.com): use none + domain below.
AUTH_COOKIE_SAMESITE=lax

# Optional: registrable domain with leading dot — cookie visible on all subdomains
# (app.domain.com cookies sent to api.domain.com when using Domain=.domain.com).
# Example production: AUTH_COOKIE_SAMESITE=none and AUTH_COOKIE_DOMAIN=.yourdomain.com
# AUTH_COOKIE_DOMAIN=

# NestJS: set CORS_ORIGINS on the API host (see api/.env.production.example).
