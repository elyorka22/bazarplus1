# Paste into Vercel → Project → Settings → Environment Variables (Production).
# Replace domain.com with your real domain.

NEXT_PUBLIC_API_URL=https://api.domain.com

# Refresh cookie: cross-subdomain (app. + api.) on the same registrable domain
AUTH_COOKIE_SAMESITE=none
AUTH_COOKIE_DOMAIN=.domain.com

NEXT_PUBLIC_DEMO_DATA=false
