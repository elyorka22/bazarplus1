# Copy to api/.env.production before: docker compose up -d --build
# Never commit api/.env.production or real secrets.

NODE_ENV=production
PORT=3000

# Swagger off in production unless explicitly enabled (see ENABLE_SWAGGER below).
ENABLE_SWAGGER=false

# Browser origins allowed (comma-separated). Required in production for credentialed API calls.
# Example: CORS_ORIGINS=https://app.example.com,http://localhost:3001
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80

# Database / Redis — default below matches docker-compose.yml service names (postgres, redis).
# For managed cloud DB/Redis, replace these two lines.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bazarplus?schema=public
REDIS_URL=redis://redis:6379

# Replace with cryptographically random strings (32+ chars) before real production.
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

CACHE_TTL_PRODUCTS_SECONDS=60
CACHE_TTL_CATEGORIES_SECONDS=300

PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret-min-16ch

# Optional: Prisma query events → `prisma_query_duration_seconds` (extra CPU; enable briefly when tuning DB).
# PRISMA_QUERY_METRICS=true

# Worker process only: Prometheus scrape port for queue_job_* metrics (default 9101).
# WORKER_METRICS_PORT=9101
# Bind worker metrics to loopback when Prometheus scrapes on the same host (not for default Docker bridge).
# WORKER_METRICS_BIND=127.0.0.1
