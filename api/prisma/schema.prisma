// Prisma schema — grocery / delivery platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  COURIER
}

enum OrderStatus {
  CREATED
  ACCEPTED
  PREPARING
  ON_THE_WAY
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  /// Legacy rows only; new flows use PAID
  COMPLETED
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  passwordHash       String               @map("password_hash")
  name               String?
  phone              String?
  role               Role                 @default(USER)
  addresses          Address[]
  orders             Order[]
  refreshTokens      RefreshToken[]
  courier            Courier?
  idempotencyRecords IdempotencyRecord[]
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @map("key")
  userId       String   @map("user_id")
  responseJson Json     @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String   @unique @map("event_id")
  payloadHash String?  @map("payload_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("webhook_events")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id         String  @id @default(uuid())
  userId     String  @map("user_id")
  label      String?
  line1      String
  line2      String?
  city       String
  postalCode String  @map("postal_code")
  lat        Float?
  lng        Float?
  isDefault  Boolean @default(false) @map("is_default")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  stock       Int         @default(0)
  imageUrl    String?     @map("image_url")
  categoryId  String      @map("category_id")
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("products")
}

model Order {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  status           OrderStatus @default(CREATED)
  totalPrice       Decimal     @map("total_price") @db.Decimal(12, 2)
  deliverySnapshot Json        @map("delivery_snapshot")
  courierId        String?     @map("courier_id")
  courier          Courier?    @relation(fields: [courierId], references: [id])
  user             User        @relation(fields: [userId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  productId       String   @map("product_id")
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  productSnapshot Json?    @map("product_snapshot")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String        @map("order_id")
  amount    Decimal       @db.Decimal(12, 2)
  status    PaymentStatus @default(PENDING)
  provider  String        @default("stripe")
  order     Order         @relation(fields: [orderId], references: [id])
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}

model Courier {
  id           String   @id @default(uuid())
  userId       String?  @unique @map("user_id")
  name         String
  phone        String
  vehicle      String?
  currentLat   Float?   @map("current_lat")
  currentLng   Float?   @map("current_lng")
  isAvailable  Boolean  @default(true) @map("is_available")
  user         User?    @relation(fields: [userId], references: [id])
  orders       Order[]

  @@map("couriers")
}
