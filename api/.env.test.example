# Copy to .env.test and adjust. Used by Jest E2E / integration (see test/setup/load-env.ts).

NODE_ENV=test
PORT=0

# Dedicated test database (never point at production).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bazarplus_test?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=test-access-secret-min-16-chars
JWT_REFRESH_SECRET=test-refresh-secret-min-16-chars

# High limit so load tests are not throttled
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100000

PAYMENT_WEBHOOK_SECRET=test-webhook-secret-min16

CACHE_TTL_PRODUCTS_SECONDS=60
CACHE_TTL_CATEGORIES_SECONDS=300
