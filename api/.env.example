# Copy to .env and adjust. Minimum lengths enforced by Joi at startup.

NODE_ENV=development
PORT=3000

# Comma-separated list of front-end origins (required when NODE_ENV=production).
# Example: https://app.yourdomain.com,https://www.yourdomain.com
# CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bazarplus?schema=public
REDIS_URL=redis://localhost:6379

# Generate strong secrets in production, e.g. openssl rand -base64 32
JWT_ACCESS_SECRET=dev-access-secret-change-me-16plus
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-16plus

# Used by AuthService response metadata only (tokens use numeric TTL in JwtModule)
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

CACHE_TTL_PRODUCTS_SECONDS=60
CACHE_TTL_CATEGORIES_SECONDS=300

# Webhook HMAC (header x-webhook-signature: sha256=<hex>); min 16 chars
PAYMENT_WEBHOOK_SECRET=development-webhook-secret-min16
